# Copy to .env.local (gitignored) to run the loop against Cashfree SANDBOX.
# For a real deploy, prefer Secret Manager over a file:
#   firebase functions:secrets:set CASHFREE_SECRET_KEY
#
# Switch the provider off mock:
PAYMENTS_PROVIDER=cashfree

# Cashfree SANDBOX credentials (from the Cashfree dashboard, Test mode):
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key
CASHFREE_API_BASE=https://sandbox.cashfree.com/pg

# Set to false if card pre-auth is NOT enabled on your Cashfree account —
# cards then fall back to pay-and-refund like UPI.
CASHFREE_CARD_PREAUTH=true

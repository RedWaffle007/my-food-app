# Non-secret function config, loaded by firebase-functions in the emulator and on
# deploy. The mock provider makes NO gateway calls, so no Cashfree keys are needed
# to run the loop locally. Real Cashfree keys go in .env.local (gitignored) or,
# for deploy, Secret Manager — see .env.local.example.
PAYMENTS_PROVIDER=mock
DEPOSIT_AMOUNT_INR=200
AGENT_FAILED_TRIP_MIN_INR=60
RIDE_FEE_INR=80
AGENT_RIDE_SHARE_PCT=80
